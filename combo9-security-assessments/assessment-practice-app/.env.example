# Copy to .env and adjust as needed. Read by src/legacy_service/config.py.

# Path to the sqlite database file. Defaults to orderbase.db in the working
# directory.
ORDERBASE_DB=orderbase.db

# Where to listen. Leave the host on loopback for local work.
ORDERBASE_HOST=127.0.0.1
ORDERBASE_PORT=5057

# 1 turns on Flask debug mode. Leave it off.
ORDERBASE_DEBUG=0

# Service token for the fulfilment sync. Ask the platform team for the real
# value; never commit it.
ORDERBASE_WMS_SYNC_TOKEN=
