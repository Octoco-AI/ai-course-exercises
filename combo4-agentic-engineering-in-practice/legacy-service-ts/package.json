{
  "name": "legacy-service-ts",
  "version": "1.4.2",
  "description": "OrderBase -- a small, deliberately dated order-tracking service. Express + node:sqlite only, 2018 house style, still running on modern Node.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "seed-data": "tsx scripts/seedData.ts",
    "gen-logs": "tsx scripts/genLogs.ts"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.3",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
