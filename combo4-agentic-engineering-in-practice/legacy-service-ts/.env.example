# Copy to .env and adjust as needed. Nothing here is secret.
#
# Nothing in this repo actually reads this file (no dotenv package -- that's
# on purpose, see CLAUDE.md). It documents the two environment variables the
# app and the test rig DO honour, both read straight from process.env.

# Path to the sqlite database file. Read by src/db.ts.
# Defaults to orderbase.db in the working directory if unset.
ORDERBASE_DB=orderbase.db

# Desired log level. NOTE: the current code hardcodes INFO in
# loggingSetup.ts; this var is here for the day we finally wire it up.
ORDERBASE_LOG_LEVEL=INFO
