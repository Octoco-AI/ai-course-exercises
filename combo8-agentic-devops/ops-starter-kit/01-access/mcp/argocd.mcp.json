{
  "mcpServers": {
    "argocd": {
      "command": "npx",
      "args": [
        "-y",
        "argocd-mcp@0.9.0",
        "stdio"
      ],
      "env": {
        "ARGOCD_BASE_URL": "${ARGOCD_BASE_URL}",
        "ARGOCD_API_TOKEN": "${ARGOCD_API_TOKEN}",
        "MCP_READ_ONLY": "true"
      }
    }
  }
}
