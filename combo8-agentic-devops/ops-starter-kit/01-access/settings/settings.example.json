    "ask": [
      "Bash(git push *)",
      "Bash(glab mr create *)",
      "Bash(glab ci run *)",
      "Bash(glab ci retry *)",
      "Bash(glab api *)",
      "Bash(ansible-playbook *)",
      "Bash(terraform plan *)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "enabledMcpjsonServers": [
    "zabbix",
    "elastic",
    "argocd",
    "kubernetes",
    "grafana",
    "gitlab"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block_mutating_ops.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
