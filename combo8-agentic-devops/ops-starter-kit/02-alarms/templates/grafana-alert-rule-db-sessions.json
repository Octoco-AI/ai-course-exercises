{
  "_about": "Trigger proposal as code — Grafana-managed alert rules in the file-provisioning format (apiVersion 1). For teams whose database metrics reach Grafana through Prometheus and postgres_exporter. Same three rules as the Zabbix template. Ships as a draft MR to the repo that provisions Grafana; never created through the API by an agent. Replace every <PLACEHOLDER>. VERIFY: postgres_exporter metric names (pg_stat_activity_count with state/datname labels, pg_settings_max_connections) against the exporter version you run, and the provisioning schema against your Grafana version — the quickest check is to build one rule in the UI and compare it with Alerting → Export. Grafana's provisioning loader may reject unknown top-level keys such as this one; delete '_about' before shipping.",
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "preventative-postgresql-sessions",
      "folder": "<ALERT_FOLDER>",
      "interval": "1m",
      "rules": [
        {
          "uid": "prev-pg-idle-in-tx",
          "title": "PostgreSQL: sessions idle in transaction (early warning)",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": { "from": 1800, "to": 0 },
              "datasourceUid": "<PROMETHEUS_DATASOURCE_UID>",
              "model": {
                "refId": "A",
                "expr": "sum(pg_stat_activity_count{datname=\"<DB_NAME>\", state=\"idle in transaction\"})",
                "instant": false,
                "range": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": { "refId": "B", "type": "reduce", "expression": "A", "reducer": "min" }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [ { "evaluator": { "type": "gt", "params": [20] } } ]
              }
            }
          ],
          "noDataState": "NoData",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "Sessions idle in transaction stayed above 20 for 30 minutes.",
            "description": "Leading indicator for session exhaustion. Routed to the agent-visible channel; does not page.",
            "runbook_url": "<RUNBOOK_URL>"
          },
          "labels": { "audience": "agent", "class": "db-session-exhaustion", "severity": "warning" }
        },
        {
          "uid": "prev-pg-headroom",
          "title": "PostgreSQL: sessions above 85% of usable",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": { "from": 600, "to": 0 },
              "datasourceUid": "<PROMETHEUS_DATASOURCE_UID>",
              "model": {
                "refId": "A",
                "expr": "sum(pg_stat_activity_count{datname=\"<DB_NAME>\"}) / (max(pg_settings_max_connections) - max(pg_settings_superuser_reserved_connections)) * 100",
                "instant": false,
                "range": true,
                "intervalMs": 60000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": { "refId": "B", "type": "reduce", "expression": "A", "reducer": "min" }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [ { "evaluator": { "type": "gt", "params": [85] } } ]
              }
            }
          ],
          "noDataState": "Alerting",
          "execErrState": "Error",
          "for": "0s",
          "annotations": {
            "summary": "Database sessions stayed above 85% of the usable limit for 10 minutes.",
            "runbook_url": "<RUNBOOK_URL>"
          },
          "labels": { "audience": "human", "route": "page", "class": "db-session-exhaustion", "severity": "critical" }
        },
        {
          "uid": "prev-pg-forecast",
          "title": "PostgreSQL: daily session peak forecast to reach the limit within 7 days",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": { "from": 3600, "to": 0 },
              "datasourceUid": "<PROMETHEUS_DATASOURCE_UID>",
              "model": {
                "refId": "A",
                "expr": "predict_linear(max_over_time(sum(pg_stat_activity_count{datname=\"<DB_NAME>\"})[1d:5m])[7d:1h], 7 * 86400) - (max(pg_settings_max_connections) - max(pg_settings_superuser_reserved_connections))",
                "instant": false,
                "range": true,
                "intervalMs": 3600000,
                "maxDataPoints": 1000
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": { "refId": "B", "type": "reduce", "expression": "A", "reducer": "last" }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [ { "evaluator": { "type": "gt", "params": [0] } } ]
              }
            }
          ],
          "noDataState": "NoData",
          "execErrState": "Error",
          "for": "1h",
          "annotations": {
            "summary": "The 7-day trend of the daily session peak crosses the usable limit within a week.",
            "description": "Nested subqueries are expensive; if your Prometheus struggles, record max_over_time(...[1d:5m]) as a recording rule and forecast on that.",
            "runbook_url": "<RUNBOOK_URL>"
          },
          "labels": { "audience": "human", "route": "ticket", "class": "db-session-exhaustion", "severity": "warning" }
        }
      ]
    }
  ]
}
