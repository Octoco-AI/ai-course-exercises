# Copy this file to .env and fill in your key.
# Octoco AI provides a Gemini key for the workshop — it arrives in your
# pre-workshop email. Outside the workshop, get a free key at:
#   https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: override the default model. Any Gemini function-calling model works.
# GEMINI_MODEL=gemini-3.1-flash-lite
