{
  "name": "tiny-agent-ts",
  "version": "0.1.0",
  "description": "A ~200-line Gemini coding agent for Combo 2 M8. Mirrors Thorsten Ball's ampcode walkthrough.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "agent": "tsx src/cli.ts",
    "agent:reference": "TINY_AGENT_IMPL=reference tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:reference": "TINY_AGENT_IMPL=reference vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
