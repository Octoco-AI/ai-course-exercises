# Copy to .env and fill in.
#
# DEFAULT: Gemini (the key Octoco provides for the workshop).
# Get a free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: which Gemini model. gemini-3.1-flash-lite is the default — cheap and
# fast for codebase Q&A. Use gemini-3.1-pro for higher quality.
# GEMINI_MODEL=gemini-3.1-flash-lite

# ---------------------------------------------------------------------------
# ALTERNATIVE: Anthropic Claude. Prefer to build on Claude? Bring your own key,
# comment out GOOGLE_API_KEY above, and uncomment these two lines instead.
# Get a key: https://console.anthropic.com/account/keys
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-sonnet-5   # or claude-haiku-4-5 (cheaper), claude-opus-4-8 (best)
# ---------------------------------------------------------------------------

# Workspace the agent operates on. Defaults to ./workspace/. Must exist.
# WORKSPACE_ROOT=./workspace

# Where the agent's Chroma index lives. Defaults to
# ../chroma-corpora/track-a-codebase/.chroma (i.e. sibling to this directory).
# CHROMA_PERSIST_ROOT=../chroma-corpora/track-a-codebase/.chroma
# CHROMA_COLLECTION_NAME=track-a-codebase

# Output dir for draft_patch. Defaults to ./patches/.
# PATCHES_ROOT=./patches

# Development port for the FastAPI server.
# PORT=8000
