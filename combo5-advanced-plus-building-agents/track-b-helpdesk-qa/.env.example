# Copy to .env and fill in.
#
# DEFAULT: Gemini (the key Octoco provides for the workshop).
# Get a free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: which Gemini model. gemini-3.1-flash-lite is the default — cheap and
# fast for helpdesk scoping (classify, retrieve, paraphrase KB content).
# Use gemini-3.1-pro for nicer prose.
# GEMINI_MODEL=gemini-3.1-flash-lite

# ---------------------------------------------------------------------------
# ALTERNATIVE: Anthropic Claude. Prefer to build on Claude? Bring your own key,
# comment out GOOGLE_API_KEY above, and uncomment these two lines instead.
# Get a key: https://console.anthropic.com/account/keys
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-haiku-4-5   # haiku is usually enough; claude-sonnet-5 for nicer prose
# ---------------------------------------------------------------------------

# Workspace — seeded from ../chroma-corpora/track-b-helpdesk/docs/ via
# ./scripts/seed-workspace.sh. Defaults to ./workspace/.
# WORKSPACE_ROOT=./workspace

# Chroma index. Defaults to the sibling chroma-corpora directory.
# CHROMA_PERSIST_ROOT=../chroma-corpora/track-b-helpdesk/.chroma
# CHROMA_COLLECTION_NAME=track-b-helpdesk

# Output dirs for draft replies and human-escalation tickets.
# DRAFT_REPLIES_ROOT=./draft-replies
# ESCALATIONS_ROOT=./escalations

# Development port.
# PORT=8000
